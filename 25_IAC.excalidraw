      "link": null,
      "locked": false,
      "text": "Terraform is HashiCorp's infrastructure as code tool. It lets you define\nresources and infrastructure in human-readable, declarative configuration files,\nand manages your infrastructure's lifecycle.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Terraform is HashiCorp's infrastructure as code tool. It lets you define resources and infrastructure in human-readable, declarative configuration files, and manages your infrastructure's lifecycle.",
      "autoResize": false,
      "lineHeight": 1.25
    },
