      "version": 181,
      "versionNonce": 1942660781,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774239851475,
      "link": null,
      "locked": false,
      "text": "Do not use fixed table structures",
      "fontSize": 15.855529361873264,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Do not use fixed table structures",
      "autoResize": true,
      "lineHeight": 1.25
    },
