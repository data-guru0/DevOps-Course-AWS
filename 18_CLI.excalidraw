    {
      "id": "zLbKGaBqZzlF9iaBmTQJc",
      "type": "text",
      "x": 394.2618673645214,
      "y": 257.3333435058594,
      "width": 615.1743859570547,
      "height": 39.63882340468316,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1492224128,
      "version": 187,
      "versionNonce": 1981626445,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774239851475,
      "link": null,
      "locked": false,
      "text": "NoSQL (Not Only SQL) is a type of database that stores data in a non-\nrelational format.",
      "fontSize": 15.855529361873266,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NoSQL (Not Only SQL) is a type of database that stores data in a non-relational format.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "o1pwmlrbrlCKa5XzNgTRH",
      "type": "text",
      "x": 394.61200949814213,
      "y": 297.63280388661315,
      "width": 446.12656223433214,
      "height": 19.81941170234158,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 254361472,
      "version": 193,
      "versionNonce": 1873477379,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774239851475,
      "link": null,
      "locked": false,
      "text": "Unlike traditional relational databases, NoSQL databases:",
      "fontSize": 15.855529361873264,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unlike traditional relational databases, NoSQL databases:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VL1DirCWSHG6QuHtpa5Hn",
      "type": "text",
      "x": 393.921538767121,
      "y": 316.79160885490637,
