      "link": null,
      "locked": false,
      "text": "\nCache Hit\n    Data already in memory\n    Returned instantly (very low latency)\nCache Miss\n    DAX queries DynamoDB\n    Stores result in cache\n    Returns to app",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nCache Hit\n    Data already in memory\n    Returned instantly (very low latency)\nCache Miss\n    DAX queries DynamoDB\n    Stores result in cache\n    Returns to app",
      "autoResize": true,
      "lineHeight": 1.25
    },
