      "link": null,
      "locked": false,
      "text": "🔹 What is NoSQL?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔹 What is NoSQL?",
      "autoResize": true,
