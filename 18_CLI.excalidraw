      "boundElements": [],
      "updated": 1774239851475,
      "link": null,
      "locked": false,
      "text": "AmazoDynamoDB is a fully managed NoSQL database service provided by AWS.\n            Unlike RDS, it does not use tables with relations. Instead, \n                        it stores data in a flexible format.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AmazoDynamoDB is a fully managed NoSQL database service provided by AWS.\n            Unlike RDS, it does not use tables with relations. Instead, \n                        it stores data in a flexible format.",
      "autoResize": true,
      "lineHeight": 1.25
    },
