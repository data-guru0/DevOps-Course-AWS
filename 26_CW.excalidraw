    {
      "id": "FCGxu-_AsbsnAOl-5GJtL",
      "type": "text",
      "x": -25.410281640690414,
      "y": 4707.0046796472525,
      "width": 549.4075317382812,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
