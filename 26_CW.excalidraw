    },
    {
      "id": "1x-mwEZ3o6fvXdGRTLuEN",
      "type": "text",
      "x": 312.43768020957845,
      "y": 937.7658475706501,
      "width": 705.0795288085938,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45",
      "roundness": null,
      "seed": 6812177,
      "version": 37,
      "versionNonce": 1408429393,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775197240062,
      "link": null,
      "locked": false,
      "text": "CloudWatch has a Free Tier, but costs can scale quickly if not managed.\n\nFree Tier: 10 custom metrics, 10 alarms, 5GB log ingestion.\nMetrics: ~$0.30 per metric/month (first 10k).\nLogs:\nIngestion: ~$0.50 per GB.\nStorage: ~$0.03 per GB.\nAlarms: ~$0.10 per alarm/month.\nDashboards: ~$3.00 per dashboard/month.\nCost Tip: Be careful with Detailed Monitorin",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CloudWatch has a Free Tier, but costs can scale quickly if not managed.\n\nFree Tier: 10 custom metrics, 10 alarms, 5GB log ingestion.\nMetrics: ~$0.30 per metric/month (first 10k).\nLogs:\nIngestion: ~$0.50 per GB.\nStorage: ~$0.03 per GB.\nAlarms: ~$0.10 per alarm/month.\nDashboards: ~$3.00 per dashboard/month.\nCost Tip: Be careful with Detailed Monitorin",
      "autoResize": true,
      "lineHeight": 1.25
    },
