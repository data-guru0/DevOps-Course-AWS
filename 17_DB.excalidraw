      "versionNonce": 2130462848,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774236765727,
      "link": null,
      "locked": false,
      "text": "Do not use fixed table structures",
      "fontSize": 15.855529361873264,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Do not use fixed table structures",
