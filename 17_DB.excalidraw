      "isDeleted": true,
      "boundElements": [],
      "updated": 1774237260915,
      "link": null,
      "locked": false,
      "text": "🔹 Types of NoSQL Databases\nKey-Value → data stored as key and value pairs\nDocument-based → data stored as JSON-like documents\nColumn-based → data stored in columns instead of rows\nGraph-based → used for relationship-heavy data",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔹 Types of NoSQL Databases\nKey-Value → data stored as key and value pairs\nDocument-based → data stored as JSON-like documents\nColumn-based → data stored in columns instead of rows\nGraph-based → used for relationship-heavy data",
      "autoResize": true,
      "lineHeight": 1.25
    },
