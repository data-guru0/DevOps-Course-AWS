      "isDeleted": true,
      "boundElements": [],
      "updated": 1775443290280,
      "link": null,
      "locked": false,
      "text": "A data store that contains all data from various sources and is saved for \nthe sake of generating reports and analysis.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A data store that contains all data from various sources and is saved for \nthe sake of generating reports and analysis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
