      "version": 369,
      "versionNonce": 29371910,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775443290280,
      "link": null,
      "locked": false,
      "text": "Compute Nodes:",
      "fontSize": 20.148640751813836,
      "fontFamily": 5,
