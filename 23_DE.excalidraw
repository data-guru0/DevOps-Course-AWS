      "versionNonce": 315100570,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775443290280,
      "link": null,
      "locked": false,
      "text": "2. Integration with AWS Glue and other services",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Integration with AWS Glue and other services",
