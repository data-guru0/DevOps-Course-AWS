      "isDeleted": true,
      "boundElements": [],
      "updated": 1775443290280,
      "link": null,
      "locked": false,
      "text": "Amazon Redshift is a fast, fully managed data warehousing service \nin the cloud, enabling businesses to execute complex analytic queries \non volumes of data—thus minimizing delays and ensuring sound \nsupport for decision-making across organizations.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon Redshift is a fast, fully managed data warehousing service \nin the cloud, enabling businesses to execute complex analytic queries \non volumes of data—thus minimizing delays and ensuring sound \nsupport for decision-making across organizations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
