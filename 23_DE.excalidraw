      "versionNonce": 1740419334,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775443290280,
      "link": null,
      "locked": false,
      "text": "Athena integrates with AWS Glue, including the \nGlue Data Catalog, a fully managed metadata repository. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Athena integrates with AWS Glue, including the \nGlue Data Catalog, a fully managed metadata repository. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
