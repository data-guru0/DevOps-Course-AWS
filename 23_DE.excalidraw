      "text": "                        Note:\nAthena follows schema-on-read, meaning:\nstructure is applied only when we query the data, \nnot when storing it.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                        Note:\nAthena follows schema-on-read, meaning:\nstructure is applied only when we query the data, \nnot when storing it.",
      "autoResize": true,
      "lineHeight": 1.25
