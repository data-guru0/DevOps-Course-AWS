    },
    {
      "id": "Yk6yntX85fhW3_MY5s4bd",
      "type": "text",
      "x": 93.77765146891272,
      "y": 12701.12525346543,
      "width": 513.1177226724786,
      "height": 99.11112467448038,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBa",
      "roundness": null,
      "seed": 99403361,
      "version": 266,
      "versionNonce": 2033217007,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773504938930,
      "link": null,
      "locked": false,
      "text": "S3 Standard is designed for frequently \naccessed data and offers high durability, \navailability, and low latency, making it \nideal for websites, applications, and active datasets.",
      "fontSize": 19.822224934896074,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 Standard is designed for frequently \naccessed data and offers high durability, \navailability, and low latency, making it \nideal for websites, applications, and active datasets.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dF0JVe2_D2fAfEE9Fz6Px",
      "type": "text",
      "x": 937.5554436577693,
      "y": 12710.273318820513,
      "width": 598.99951171875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBb",
      "roundness": null,
      "seed": 1289099617,
      "version": 59,
      "versionNonce": 1461826095,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "djOWZLkCRXgp_Ed3iQmKT",
          "type": "arrow"
        }
      ],
      "updated": 1773504991611,
      "link": null,
      "locked": false,
      "text": "S3 Intelligent-Tiering automatically moves data \nbetween access tiers depending on usage patterns, \nhelping optimize costs when access frequency is unpredictable",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 Intelligent-Tiering automatically moves data \nbetween access tiers depending on usage patterns, \nhelping optimize costs when access frequency is unpredictable",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7Eh10e2WBpfZDy8Luj4xG",
      "type": "text",
      "x": -206.0001169840493,
      "y": 12979.273346794962,
      "width": 578.7195434570312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBc",
      "roundness": null,
      "seed": 183525473,
      "version": 227,
      "versionNonce": 276655809,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "yuUZDmqfsRnRyz8u8dysg",
          "type": "arrow"
        }
      ],
      "updated": 1773505026779,
      "link": null,
      "locked": false,
      "text": "S3 Standard-Infrequent Access (Standard-IA) is suitable \nfor data that is accessed occasionally but still requires \nrapid retrieval, such as backups and disaster recovery files.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 Standard-Infrequent Access (Standard-IA) is suitable \nfor data that is accessed occasionally but still requires \nrapid retrieval, such as backups and disaster recovery files.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AMx1Hali1beERb9MoD2UF",
      "type": "text",
      "x": 1182.3333011203342,
      "y": 12995.606460571275,
      "width": 565.6195678710938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBd",
      "roundness": null,
      "seed": 1908103745,
      "version": 154,
      "versionNonce": 1328054543,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773504903648,
      "link": null,
      "locked": false,
      "text": "S3 One Zone-IA stores data in a single availability zone \ninstead of multiple zones, making it cheaper but slightly \nless resilient, and it is often used for secondary backups \nor easily reproducible data.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 One Zone-IA stores data in a single availability zone \ninstead of multiple zones, making it cheaper but slightly \nless resilient, and it is often used for secondary backups \nor easily reproducible data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tBvj5IZSj8RCu3EE7_RlO",
      "type": "text",
      "x": -58.25003814697274,
      "y": 13301.88445621065,
      "width": 507.6795654296875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBe",
      "roundness": null,
      "seed": 449362255,
      "version": 121,
      "versionNonce": 2038992783,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773504914362,
      "link": null,
      "locked": false,
      "text": "S3 Glacier is an archival storage class designed for \nlong-term data retention where access is rare, \noffering very low storage cost but longer retrieval \ntimes ranging from minutes to hours.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 Glacier is an archival storage class designed for \nlong-term data retention where access is rare, \noffering very low storage cost but longer retrieval \ntimes ranging from minutes to hours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VoI60_PN61LJk-Q-KMuJ4",
      "type": "text",
      "x": 978.4998779296875,
      "y": 13308.384471469439,
      "width": 691.99951171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBf",
      "roundness": null,
