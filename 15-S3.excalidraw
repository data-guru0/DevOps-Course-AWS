      "updated": 1773507084871,
      "link": null,
      "locked": false,
      "text": "AWS Storage Gateway connects on-premise infrastructure to AWS cloud storage.\nIt allows companies to use AWS storage while keeping local systems running.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS Storage Gateway connects on-premise infrastructure to AWS cloud storage.\nIt allows companies to use AWS storage while keeping local systems running.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7WNPIySVotDsyjxS397mg",
      "type": "rectangle",
      "x": 459.5555487738717,
      "y": 15333.474262588728,
