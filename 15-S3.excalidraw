      "roundness": null,
      "seed": 431238497,
      "version": 53,
      "versionNonce": 1143318337,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773507121778,
      "link": null,
      "locked": false,
      "text": "Companies may still have local servers and storage, but they want to store backups or archives in AWS.\nStorage Gateway acts like a bridge between on-premise storage and AWS cloud storage.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Companies may still have local servers and storage, but they want to store backups or archives in AWS.\nStorage Gateway acts like a bridge between on-premise storage and AWS cloud storage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
