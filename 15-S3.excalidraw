      "link": null,
      "locked": false,
      "text": "S3 Versioning keeps multiple versions of the same file inside a bucket.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 Versioning keeps multiple versions of the same file inside a bucket.",
      "autoResize": true,
      "lineHeight": 1.25
