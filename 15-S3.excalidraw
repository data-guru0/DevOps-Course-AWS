    {
      "id": "di9GEandcBE8yZwRCyIb7",
      "type": "text",
      "x": 161.55553521050376,
      "y": 15473.992851184648,
      "width": 1010.8192138671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
