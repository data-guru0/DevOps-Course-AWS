      ],
      "updated": 1774410850062,
      "link": null,
      "locked": false,
      "text": "The following diagram illustrates how Amazon \nEKS integrates your Kubernetes clusters \nwith the AWS cloud, depending on \nwhich method of cluster creation you choose:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
