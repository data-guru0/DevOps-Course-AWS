      "link": null,
      "locked": false,
      "text": "Developer builds container → stores in ECR\nEKS cluster pulls image and schedules it\nRuns on EC2 nodes or Fargate\nPods host the app → exposed to users via Load Balancer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Developer builds container → stores in ECR\nEKS cluster pulls image and schedules it\nRuns on EC2 nodes or Fargate\nPods host the app → exposed to users via Load Balancer",
      "autoResize": true,
      "lineHeight": 1.25
    },
