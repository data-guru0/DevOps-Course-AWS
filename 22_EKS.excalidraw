      "boundElements": null,
      "updated": 1774410957738,
      "link": null,
      "locked": false,
      "text": "You create and manage worker nodes \n(EC2 or Fargate), \ngiving more control but more responsibility.",
      "fontSize": 19.082637813176724,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You create and manage worker nodes \n(EC2 or Fargate), \ngiving more control but more responsibility.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t5hP6kZTOvAvKaDMherPm",
      "type": "text",
      "x": 297.7239175852603,
      "y": 1052.49136243457,
      "width": 392.7936896427463,
      "height": 93.10122246533122,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b07",
      "roundness": null,
      "seed": 947427108,
      "version": 192,
      "versionNonce": 704571044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774410947156,
      "link": null,
      "locked": false,
      "text": "AWS automatically manages infrastructure, \nscaling, and node provisioning, \nso you just deploy apps without worrying \nabout servers.",
      "fontSize": 18.62024449306624,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS automatically manages infrastructure, \nscaling, and node provisioning, \nso you just deploy apps without worrying \nabout servers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
