      "text": "1. Serverless architecture",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Serverless architecture",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eRAy1G7IxZcV-SUtHXiPb",
      "type": "text",
      "x": 101.43563057484425,
      "y": 8222.376601327334,
      "width": 547.9196166992188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 1430076005,
      "version": 23,
      "versionNonce": 549684581,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775395954107,
      "link": null,
      "locked": false,
      "text": "AWS Athena operates on a serverless architecture, \nmeaning you don't have to manage or configure servers. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS Athena operates on a serverless architecture, \nmeaning you don't have to manage or configure servers. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "psiwKgo0CLk1-xXrEwkTo",
      "type": "text",
      "x": 95.235618367813,
