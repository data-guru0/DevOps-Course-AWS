      "versionNonce": 1935118533,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775395954107,
      "link": null,
      "locked": false,
      "text": "2. Integration with AWS Glue and other services",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Integration with AWS Glue and other services",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Go0Dahxao4h3bYVqjoMI-",
      "type": "text",
      "x": 98.63561226429738,
      "y": 8322.77656470624,
      "width": 564.9196166992188,
      "height": 50,
      "angle": 0,
