    {
      "id": "cVXDpm8bYYc7FhjXkbpId",
      "type": "text",
      "x": 94.19074112391968,
      "y": 3456.77773874498,
      "width": 391.55169677734375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
