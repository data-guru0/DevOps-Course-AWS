      "seed": 782267300,
      "version": 6,
      "versionNonce": 1585257244,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774420043195,
      "link": null,
      "locked": false,
      "text": "After creating the EKS cluster, applications can \nbe deployed by connecting via kubectl and running \ncontainerized workloads as pods.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After creating the EKS cluster, applications can \nbe deployed by connecting via kubectl and running \ncontainerized workloads as pods.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "La03KqGJ2OVbaxj6DP7a_",
      "type": "text",
      "x": 95.6774447896849,
      "y": 3529.626218367476,
      "width": 417.0076599121094,
      "height": 60,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1363546140,
      "version": 6,
      "versionNonce": 667595940,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774420043195,
      "link": null,
      "locked": false,
      "text": "These pods run on worker nodes (EC2/Fargate) and \ncan be exposed to users using Kubernetes services \nlike LoadBalancer.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These pods run on worker nodes (EC2/Fargate) and \ncan be exposed to users using Kubernetes services \nlike LoadBalancer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ns-TEfqT5YtwaDgJeoCIa",
      "type": "text",
      "x": 93.10025824451463,
      "y": 3603.8727443039743,
      "width": 779.2314453125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1227378724,
      "version": 108,
      "versionNonce": 383997852,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774420043195,
      "link": null,
      "locked": false,
      "text": "Further steps include scaling, monitoring, and \nmanaging deployments, which are handled efficiently by \nKubernetes in EKS.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Further steps include scaling, monitoring, and \nmanaging deployments, which are handled efficiently by \nKubernetes in EKS.",
      "autoResize": false,
      "lineHeight": 1.25
    },
