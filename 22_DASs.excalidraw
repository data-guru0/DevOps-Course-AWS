      "type": "text",
      "x": 28.271855932446897,
      "y": 491.60798993073576,
      "width": 752.9795532226562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
