      "updated": 1774424869274,
      "link": null,
      "locked": false,
      "text": "->Leader node handles SQL parsing and distributes queries\n->Compute nodes store data in columnar format and execute queries\n->MPP enables parallel processing → faster analytics",
      "fontSize": 19.49206542968751,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "->Leader node handles SQL parsing and distributes queries\n->Compute nodes store data in columnar format and execute queries\n->MPP enables parallel processing → faster analytics",
      "autoResize": true,
      "lineHeight": 1.25
    },
