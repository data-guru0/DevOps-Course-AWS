    {
      "id": "nxjHZxUAObiK3MbWWEkDL",
      "type": "text",
      "x": 518.0833613830384,
      "y": 853.1813222989119,
      "width": 350.27972412109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
