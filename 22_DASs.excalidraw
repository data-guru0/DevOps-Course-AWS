      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3E",
      "roundness": null,
      "seed": 66744395,
      "version": 18,
      "versionNonce": 571682853,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775395954107,
      "link": null,
      "locked": false,
      "text": "Athena integrates with AWS Glue, including the \nGlue Data Catalog, a fully managed metadata repository. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Athena integrates with AWS Glue, including the \nGlue Data Catalog, a fully managed metadata repository. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
