      "roundness": null,
      "seed": 75419172,
      "version": 49,
      "versionNonce": 104522652,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423676457,
      "link": null,
      "locked": false,
      "text": "Massively Parallel Processing (MPP):",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Massively Parallel Processing (MPP):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LWMjN6DYtlu4P80yJHUAK",
      "type": "text",
      "x": 547.1309513662973,
      "y": 880.8003844501395,
      "width": 765.3594360351562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1a",
      "roundness": null,
      "seed": 1758711076,
      "version": 43,
      "versionNonce": 81006620,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423676457,
      "link": null,
      "locked": false,
      "text": "A computing architecture through which a single query workload or dataset is \nshared by multiple processors or nodes, where the pace of processing these \nqueries is much quicker than one processor handling all these queries.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A computing architecture through which a single query workload or dataset is \nshared by multiple processors or nodes, where the pace of processing these \nqueries is much quicker than one processor handling all these queries.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kz3QS_6kyt6lbQwhSPH9l",
      "type": "text",
      "x": 466.774671010269,
      "y": 1078.1190534319198,
      "width": 552.5394897460938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 1380897436,
      "version": 68,
      "versionNonce": 1845915940,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774423084755,
      "link": null,
      "locked": false,
      "text": "Leader node handles SQL parsing and distributes queries",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leader node handles SQL parsing and distributes queries",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9naJi8uLhdG8bGj-dBbnJ",
      "type": "text",
      "x": 418.7246526997221,
      "y": 1113.1190534319198,
      "width": 648.6395263671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 1555182884,
      "version": 68,
      "versionNonce": 816816924,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774423084755,
      "link": null,
      "locked": false,
      "text": "Compute nodes store data in columnar format and execute queries",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compute nodes store data in columnar format and execute queries",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EB_aiDP_Z9hP7Yj3zMRyE",
      "type": "text",
      "x": 495.7446111958159,
      "y": 1148.1190534319198,
      "width": 494.599609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1d",
      "roundness": null,
      "seed": 647110428,
      "version": 68,
      "versionNonce": 769961124,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774423084755,
      "link": null,
      "locked": false,
      "text": "MPP enables parallel processing → faster analytics",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MPP enables parallel processing → faster analytics",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "miM1HbbBZtNqEN7fDs6ms",
      "type": "text",
      "x": -244.30304720743038,
