      "index": "b11",
      "roundness": null,
      "seed": 7307036,
      "version": 159,
      "versionNonce": 951948452,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423693088,
      "link": null,
      "locked": false,
      "text": "A cluster in Amazon Redshift is a collection of one or more computing nodes \nthat store data and work together on queries.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A cluster in Amazon Redshift is a collection of one or more computing nodes \nthat store data and work together on queries.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hdxYkN-VCRIoQVAV6nUCa",
      "type": "text",
      "x": 522.5628451230484,
      "y": 649.0871537569537,
      "width": 124.95991516113281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b12",
      "roundness": null,
      "seed": 429050660,
      "version": 228,
      "versionNonce": 2141579812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423834931,
      "link": null,
      "locked": false,
      "text": "Leader Node:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leader Node:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CHM4w0SEdOagmy9KSgw3A",
      "type": "text",
      "x": 539.3316361572472,
      "y": 676.7523052814404,
      "width": 800.6994018554688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 778140580,
      "version": 239,
      "versionNonce": 720206116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423827982,
      "link": null,
      "locked": false,
      "text": "The head node is responsible for dealing with client connections, planning queries, \nand coordinating all execution of distributed SQL. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The head node is responsible for dealing with client connections, planning queries, \nand coordinating all execution of distributed SQL. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5pRZxG2nk4oGcFSDj2FcN",
      "type": "text",
      "x": 520.8954705044399,
      "y": 751.253164469787,
      "width": 154.09671900047937,
      "height": 25.185800939767294,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 1297621924,
      "version": 368,
      "versionNonce": 1249106588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774423676457,
      "link": null,
      "locked": false,
      "text": "Compute Nodes:",
      "fontSize": 20.148640751813836,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compute Nodes:",
