    {
      "id": "VVcF0CYZKtDk_Yj0cSC0N",
      "type": "text",
      "x": 248.66668701171875,
      "y": 229.83334350585938,
      "width": 302.15631103515625,
      "height": 207.6666259765626,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1g",
      "roundness": null,
      "seed": 375166403,
      "version": 89,
      "versionNonce": 1561461475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774251816253,
      "link": null,
      "locked": false,
      "text": "NO server management needed ❌\nYou DON'T handle:\n❌ EC2\n❌ Scaling\n❌ OS\nYou ONLY write:\n✔ Function (code)\nExecution = On-demand\nPay = Only when code runs ",
      "fontSize": 18.45925564236112,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NO server management needed ❌\nYou DON'T handle:\n❌ EC2\n❌ Scaling\n❌ OS\nYou ONLY write:\n✔ Function (code)\nExecution = On-demand\nPay = Only when code runs ",
      "autoResize": true,
      "lineHeight": 1.25
    },
