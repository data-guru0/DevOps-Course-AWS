      "link": null,
      "locked": false,
      "text": "Client sends a request to API Gateway (method request), which forwards it as an integration request to AWS Lambda for processing.\nLambda processes it and returns an integration response, which API Gateway converts into a method response back to the client.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client sends a request to API Gateway (method request), which forwards it as an integration request to AWS Lambda for processing.\nLambda processes it and returns an integration response, which API Gateway converts into a method response back to the client.",
      "autoResize": true,
      "lineHeight": 1.25
    },
