    {
      "id": "JlyOHtI0CLK4AoFL5tE_a",
      "type": "text",
      "x": 693.6152595531019,
      "y": 666.9319333483941,
      "width": 823.139404296875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
