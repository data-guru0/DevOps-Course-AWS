      "text": "What is FARGATE",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is FARGATE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "P98qKXqV-GjzBYWV5tR1q",
      "type": "text",
      "x": 666.4440916463399,
      "y": 1115.558981743411,
      "width": 726.219482421875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4C",
      "roundness": null,
      "seed": 487328220,
      "version": 58,
      "versionNonce": 180941028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774338779726,
      "link": null,
      "locked": false,
      "text": "AWS Fargate is a serverless compute engine for containers. \nIt allows applications to run without managing virtual machines or servers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS Fargate is a serverless compute engine for containers. \nIt allows applications to run without managing virtual machines or servers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
