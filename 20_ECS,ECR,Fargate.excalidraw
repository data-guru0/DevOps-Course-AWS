      "isDeleted": false,
      "boundElements": [],
      "updated": 1774338369098,
      "link": null,
      "locked": false,
      "text": "Amazon Elastic Container Registry is a fully managed Docker image storage service. \nIt allows developers to store, manage, and retrieve container images securely.\nWhen a Docker image is built locally, it needs to be stored somewhere \nbefore deployment. ECR acts as that centralized storage.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon Elastic Container Registry is a fully managed Docker image storage service. \nIt allows developers to store, manage, and retrieve container images securely.\nWhen a Docker image is built locally, it needs to be stored somewhere \nbefore deployment. ECR acts as that centralized storage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
