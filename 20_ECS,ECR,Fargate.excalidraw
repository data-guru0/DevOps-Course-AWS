      "link": null,
      "locked": false,
      "text": "Amazon Elastic Container Service is a container orchestration service provided by AWS. \nIt is used to run and manage Docker containers without needing to manually \nhandle the underlying infrastructure logic of scheduling and scaling.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon Elastic Container Service is a container orchestration service provided by AWS. \nIt is used to run and manage Docker containers without needing to manually \nhandle the underlying infrastructure logic of scheduling and scaling.",
      "autoResize": true,
      "lineHeight": 1.25
    },
