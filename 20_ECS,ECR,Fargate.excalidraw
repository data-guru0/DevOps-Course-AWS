    {
      "id": "3dSGUmShT5hqdvOpGtKa8",
      "type": "text",
      "x": 753.3301121826236,
      "y": 868.6296698416369,
      "width": 575.8956784711029,
      "height": 115.56010032966283,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b46",
      "roundness": null,
      "seed": 528538596,
      "version": 144,
      "versionNonce": 2065171300,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774338784693,
      "link": null,
      "locked": false,
      "text": "Imagine a new update is released for the payment service.\nThe developer builds a new Docker image and pushes it to ECR.\nECS then pulls the updated image and replaces the old \ncontainers without stopping the application.\nThis allows continuous deployment without downtime.",
      "fontSize": 18.489616052746054,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine a new update is released for the payment service.\nThe developer builds a new Docker image and pushes it to ECR.\nECS then pulls the updated image and replaces the old \ncontainers without stopping the application.\nThis allows continuous deployment without downtime.",
      "autoResize": true,
      "lineHeight": 1.25
    },
