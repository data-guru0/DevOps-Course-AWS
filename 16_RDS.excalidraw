      "link": null,
      "locked": false,
      "text": "With RDS, AWS handles:\n\n    Database setup\n    Automatic backups\n    Software patching and updates\n    Scaling resources\n    Security and monitoring",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With RDS, AWS handles:\n\n    Database setup\n    Automatic backups\n    Software patching and updates\n    Scaling resources\n    Security and monitoring",
