      "updated": 1773900045413,
      "link": null,
      "locked": false,
      "text": "Amazon RDS (Relational Database Service) is a managed database \nservice provided by AWS that allows you to easily create, \noperate, and scale relational databases in the cloud.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon RDS (Relational Database Service) is a managed database \nservice provided by AWS that allows you to easily create, \noperate, and scale relational databases in the cloud.",
      "autoResize": true,
      "lineHeight": 1.25
    },
